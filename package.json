{
  "name": "ocra",
  "version": "0.1.0",
  "description": "Zero-dependency RFC 6238 TOTP, RFC 4226 HOTP and RFC 6287 OCRA for Node, Deno, Bun, browsers and edge runtimes.",
  "keywords": [
    "totp",
    "hotp",
    "otp",
    "2fa",
    "mfa",
    "two-factor",
    "authenticator",
    "rfc6238",
    "rfc4226",
    "webcrypto",
    "ocra",
    "rfc6287",
    "challenge-response",
    "oath"
  ],
  "license": "Apache-2.0",
  "author": "Tadej Golobic",
  "homepage": "https://github.com/golobitch/ocra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/golobitch/ocra.git"
  },
  "bugs": {
    "url": "https://github.com/golobitch/ocra/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
